{
  "organization": "塘环单车翻新中心（18 人）",
  "tagline": "用已签认的轮圈跳动和维修级别训练双阈值，再按测量日留出验证，解释新单分档；补录签认以版本号认新旧。",
  "source": "《回正台轮圈跳动_1101.csv》与返修工单签认（含历次版本与收到时间）",
  "record_name": "回正测量单",
  "algorithm": "带低估惩罚的三档阈值搜索",
  "formula": "同一工单的各次签认按版本号保留全部历史，乱序补录以版本号而非到达时间认新旧。按测量日留出最晚若干日：训练只采用留出期开始前已收到的最新签认，留出工单按发起分析时的最新签认计分。验证集仅用于报告费用和误档。",
  "decision_prompt": "哪些轮圈进入重调或复验台，错派一档的代价是否可接受？",
  "fields": [
    {
      "key": "ticket",
      "label": "工单号",
      "type": "text",
      "example": "TH-P04"
    },
    {
      "key": "day",
      "label": "跳动测量日",
      "type": "date",
      "example": "2026-11-22"
    },
    {
      "key": "wobble",
      "label": "侧向总跳动（mm）",
      "type": "number",
      "example": 1.25,
      "min": 0,
      "max": 20
    },
    {
      "key": "grade",
      "label": "维修签认",
      "type": "choice",
      "example": "待排工",
      "choices": [
        "轻调",
        "重调",
        "复验",
        "待排工"
      ]
    },
    {
      "key": "version",
      "label": "签认版本",
      "type": "integer",
      "required": false,
      "min": 1,
      "max": 9999,
      "example": 2,
      "help": "同一工单每次签认各占一行，版本号越大判新；乱序补录也以版本号认新旧。待排工单无需填写。"
    },
    {
      "key": "received_at",
      "label": "签认收到时间",
      "type": "datetime",
      "required": false,
      "example": "2026-11-23T10:30",
      "help": "签认实际送达时间，补录可填历史时间。训练只采用留出期开始前已收到的签认。待排工单无需填写。"
    }
  ],
  "parameters": [
    {
      "key": "holdout",
      "label": "留出签认日",
      "type": "integer",
      "min": 1,
      "max": 12,
      "default": 2
    },
    {
      "key": "under_cost",
      "label": "低估工序惩罚倍数",
      "type": "number",
      "min": 1,
      "max": 20,
      "default": 3
    }
  ]
}
